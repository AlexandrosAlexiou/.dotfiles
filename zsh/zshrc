# This is required to load zsh along with everything else as sudo
# This effectively ignores permission issues and loads the system normally
ZSH_DISABLE_COMPFIX=true

# Path to your oh-my-zsh installation.
export ZSH="${HOME}/.oh-my-zsh"

# Path to Homebrew executable
export PATH=/opt/homebrew/bin:$PATH

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="powerlevel10k/powerlevel10k"

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in ~/.oh-my-zsh/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
zstyle ':omz:update' mode disabled  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 7

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS=true

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Load ssh-keys for the ssh-agent lazy, on first use
zstyle :omz:plugins:ssh-agent lazy yes

# Source forgit (needs to be sourced before the plugin is loaded)
[ -f ~/.forgit.zsh ] && . ~/.forgit.zsh

# Which plugins would you like to load?
# Standard plugins can be found in ~/.oh-my-zsh/plugins/*
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
#
# `autoupdate` is deliberately absent: `zstyle ':omz:update' mode disabled`
# above makes it a no-op, yet it still forks `tput` five times on every start
# just to pick colors it never prints. Run `upgrade_oh_my_zsh_all` by hand, or
# re-add the plugin, if you want custom plugins updated automatically again.
#
# `mise` is deliberately absent too; it is activated by hand below so that its
# completion is not regenerated on every single shell start. See there.
plugins=(git zsh-autosuggestions fast-syntax-highlighting colored-man-pages ssh-agent forgit)

# zsh-autosuggestions re-binds every ZLE widget on each prompt unless told not
# to. That costs ~13 ms per prompt for nothing; bindings do not change at
# runtime here. Rebind manually with `_zsh_autosuggest_bind_widgets` if needed.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

# oh-my-zsh unconditionally runs `scutil --get LocalHostName` here to build
# $SHORT_HOST, which it only uses to name the .zcompdump file. That is a ~10 ms
# fork on this machine and there is no supported way to skip it: shadowing
# `scutil` with a cached function works, but when the cache is empty it
# silently yields `.zcompdump--5.9` and forces a full compinit rebuild. Not
# worth the blast radius for ~10 ms of time that no longer blocks the prompt.

# Fire up oh-my-zsh
source $ZSH/oh-my-zsh.sh

# Powerlevel10k instant prompt. Deliberately placed after oh-my-zsh: at the
# top it paints a cached prompt and then git status pops in ~250 ms later,
# which feels slower than rendering the full prompt once.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Activate mise directly rather than through the oh-my-zsh `mise` plugin. The
# plugin runs the same `eval "$(mise activate zsh)"`, but also re-runs
# `mise completion zsh` in the background on *every* shell start to rewrite a
# file that only changes when mise itself is upgraded -- one wasted exec per
# terminal tab. `mise activate` bakes the live $PATH into its output, so that
# fork genuinely cannot be cached; only the completion refresh is conditional.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
  () {
    local comp="${ZSH_CACHE_DIR:-$ZSH/cache}/completions/_mise"
    [[ -s $comp && ! ${commands[mise]} -nt $comp ]] && return
    command mkdir -p $comp:h
    # Backgrounded and detached: nothing this shell does depends on it.
    ( command mise completion zsh >| $comp 2>/dev/null & )
  }
fi

# Set history configuration settings
HIST_STAMPS="%d/%m/%Y %T"
HISTSIZE=1000000000
SAVEHIST=$HISTSIZE
HISTFILE=$HOME/.zsh_history

# setopt configurations
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY
unsetopt histverify

# Make nvim my default editor
export VISUAL=nvim
export EDITOR="$VISUAL"

# Setup the path for ripgrep configuration
export RIPGREP_CONFIG_PATH="$HOME/.config/rg/config"

# Add ~/.local/bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# mise is activated by hand above, just after oh-my-zsh. Its hooks spawn
# `mise hook-env` (~15 ms, spiky on machines where process launches are
# inspected, e.g. Defender). Two changes keep tool switching but avoid the
# spawn where it cannot matter:
#   1. Drop the per-prompt hook entirely.
#   2. On `cd`, only run hook-env when the set of mise config files visible
#      from the new directory (walking up to /) or their mtimes changed. Moving
#      around inside one project therefore costs a few stat() calls, not a
#      process. mise here reads only its own files + .tool-versions
#      (idiomatic_version_file_enable_tools is empty), so the list below is
#      complete for this setup. If you enable idiomatic files, add them.
if (( $+functions[_mise_hook_precmd] )); then
  autoload -Uz add-zsh-hook
  add-zsh-hook -d precmd _mise_hook_precmd
fi
if (( $+functions[_mise_hook_chpwd] )); then
  zmodload -F zsh/stat b:zstat
  typeset -ga __mise_config_names=(
    mise.toml .mise.toml mise.local.toml .mise.local.toml
    .config/mise.toml .config/mise/config.toml mise/config.toml .mise/config.toml
    .tool-versions
  )
  # Fingerprint of every mise config file from $PWD up to /, with mtimes.
  function __mise_fingerprint() {
    local d=$PWD f; local -a st; REPLY=
    while :; do
      for f in $__mise_config_names; do
        if [[ -f $d/$f ]]; then
          zstat -A st +mtime -- $d/$f 2>/dev/null && REPLY+="$d/$f@$st[1];"
        fi
      done
      [[ $d == / ]] && break
      d=${d:h}
    done
  }
  __mise_fingerprint; typeset -g __mise_last_fp=$REPLY
  function _mise_hook_chpwd() {
    export __MISE_ZSH_CHPWD_RAN=1
    __mise_fingerprint
    [[ $REPLY == $__mise_last_fp ]] && return 0
    __mise_last_fp=$REPLY
    _mise_hook --reason chpwd
  }
fi

# Activate zoxide
if (( $+commands[zoxide] )); then
    # `zoxide init zsh` prints the same static ~150-line script regardless of
    # $PWD, $PATH or $_ZO_DATA_DIR (verified by diffing), so there is no reason
    # to fork zoxide for it on every shell start. Cache it, and regenerate only
    # when the binary itself is newer than the cache, i.e. after an upgrade.
    () {
        local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zoxide-init.zsh"
        if [[ ! -s $cache || ${commands[zoxide]} -nt $cache ]]; then
            command zoxide init zsh >| $cache || return
        fi
        source $cache
    }
    # zoxide's chpwd hook spawns `zoxide add` synchronously (~25 ms per cd).
    # Recording the directory does not need to block the prompt: do it in a
    # detached subshell so the next prompt appears immediately.
    function __zoxide_hook() {
        ( command zoxide add -- "$PWD" &>/dev/null & )
    }
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[ ! -f ~/.p10k.zsh ] || . ~/.p10k.zsh

# Source my custom aliases
[ -f ~/.zsh_aliases ] && . ~/.zsh_aliases

# Source my custom functions
[ -f ~/.zsh_functions ] && . ~/.zsh_functions

# Source fzf, to be able to use it
[ -f ~/.fzf.zsh ] && . ~/.fzf.zsh

# Source my fzf configurations
[ -f ~/.fzf.config ] && . ~/.fzf.config

# Opt-in prompt latency profiler: `ZSH_PROMPT_PROFILE=1 exec zsh`, then work
# normally. Prompts slower than 30 ms are logged to ~/.cache/zsh-prompt-profile.log
# with a per-hook breakdown. Lives next to this file in the dotfiles repo.
if [[ -n $ZSH_PROMPT_PROFILE ]]; then
  source "${${(%):-%x}:A:h}/prompt-profile.zsh"
fi

# Setup custom keybinds
# '^M' or '\n' play the role of <Enter> so that the command can run automatically
bindkey -s '^F' 'foc\n'
bindkey -s '^G' 'frg\n'
bindkey -s '^R' 'fr\n'
bindkey -s '^H' 'fh\n'
bindkey -s '^L' 'lazygit\n'
bindkey -s '^V' 'sjdk\n'
bindkey -s '^P' 'spy\n'

# Add gnubin to path
export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"

# Set to the default JDK. `/usr/libexec/java_home` forks a process on every
# shell start to answer a question whose result only changes when a JDK is
# installed, removed or upgraded, so cache the answer on disk. `home` is a
# local, never the inherited $JAVA_HOME: mise exports its own JAVA_HOME from
# the activation above and reusing it would silently make this line a no-op.
() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/java_home-25" home=
  # `$(<file)` is read by the shell itself, no fork.
  [[ -r $cache ]] && home="$(<$cache)"
  if [[ ! -x $home/bin/java ]]; then
    home="$(/usr/libexec/java_home -v 25 2>/dev/null)"
    [[ -n $home ]] && print -r -- $home >| $cache
  fi
  [[ -n $home ]] && export JAVA_HOME=$home
}

# fnm is no longer activated here: node is managed by mise (global `node = "lts"`
# in ~/.config/mise/config.toml, per-project via .tool-versions/.nvmrc/.node-version,
# which mise also reads). fnm's `--use-on-cd` hook spawned `fnm use` on every cd
# into a directory with a package.json, and its PATH entry could shadow mise's node.
# To use fnm ad hoc: eval "$(fnm env)"

# Add the GNU libtool to PATH
export PATH="/opt/homebrew/opt/libtool/libexec/gnubin:$PATH"

# Neovide config variables
export NEOVIDE_FRAMELESS=true
export NEOVIDE_FRAME=none

